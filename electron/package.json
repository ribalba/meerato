{
  "name": "meerato-desktop",
  "productName": "Meerato",
  "version": "0.0.1",
  "description": "Desktop wrapper for the Meerato to-do app.",
  "main": "main.js",
  "desktopName": "meerato.desktop",
  "homepage": "https://github.com/ribalba/meerkat",
  "author": {
    "name": "Didi Hoffmann",
    "email": "didi@ribalba.de"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron . --class=meerato",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "42.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.meerato.desktop",
    "productName": "Meerato",
    "directories": { "buildResources": "build", "output": "dist" },
    "files": ["main.js", "package.json", "build/icon.png"],
    "protocols": [
      { "name": "Meerato", "schemes": ["meerato"] }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office",
      "synopsis": "Desktop wrapper for the Meerato to-do app.",
      "syncDesktopName": true,
      "icon": "build/icons",
      "executableName": "meerato",
      "desktop": {
        "entry": { "StartupWMClass": "meerato" }
      }
    }
  }
}
