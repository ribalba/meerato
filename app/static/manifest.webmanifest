{
  "name": "meerato",
  "short_name": "meerato",
  "description": "Offline-capable todos with buckets, subtasks, comments and watchers.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#1b1c1d",
  "theme_color": "#2185d0",
  "icons": [
    { "src": "/static/logo-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/static/logo-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
